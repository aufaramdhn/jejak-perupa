# Environment Variables Template - Jejak Perupa
# Salin file ini menjadi .env atau .env.local dan sesuaikan nilainya.

# ==========================================
# 1. DATABASE CONNECTION (SUPABASE / POSTGRESQL)
# ==========================================
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)

# DATABASE_URL (Transaction Pooler - Port 6543) digunakan oleh Next.js Server Actions & Runtime
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL (Direct Connection - Port 5432) digunakan oleh Prisma CLI untuk migrasi & db push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ==========================================
# 2. SUPABASE PUBLIC & SERVICE ROLE KEYS
# ==========================================
# Ambil dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ==========================================
# 3. NEXT.js APP CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
